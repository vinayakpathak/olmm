{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Compile current TeX file with Tectonic",
      "type": "shell",
      "command": "tectonic",
      "args": [
        "--outdir",
        "${fileDirname}",
        "${file}"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared",
        "clear": true
      }
    }
  ]
}
