   140	    \ind{H < \tau_t(a) < \infty}.
   141	\]
   142	Taking conditional expectations given the realized history \(P_1,\dots,P_t\),
   143	we get
   144	\[
   145	    \mathbb{E}\left[
   146	        r_t(a) - r^H_t(a)
   147	        \mid P_1,\dots,P_t
   148	    \right]
   149	    \leq
   150	    \Pr\bigl[H < \tau_t(a) < \infty \mid P_1,\dots,P_t\bigr]
   151	    \leq
   152	    \beta(H),
   153	\]
   154	where the last inequality is exactly the definition of \(\beta(H)\). Taking
   155	expectations and summing over \(t\), this gives
   156	\[
   157	    \mathbb{E}\left[\sum_{t=1}^T r_t(a)\right]
   158	    \leq
   159	    \mathbb{E}\left[\sum_{t=1}^T r^H_t(a)\right]
   160	    +
   161	    T\beta(H).
   162	\]
   163	Since this holds for every fixed quote \(a\),
   164	\[
   165	    \max_{a \in [0,1]}
   166	    \mathbb{E}\left[\sum_{t=1}^T r_t(a)\right]
   167	    \leq
   168	    \max_{a \in [0,1]}
   169	    \mathbb{E}\left[\sum_{t=1}^T r^H_t(a)\right]
   170	    +
   171	    T\beta(H).
   172	\]
   173	
   174	On the other hand, along every realized path we have
   175	\(r^H_t(a_t) \leq r_t(a_t)\) for every \(t\). Therefore
   176	\[
   177	    \mathbb{E}\left[\sum_{t=1}^T r_t(a_t)\right]
   178	    \geq
   179	    \mathbb{E}\left[\sum_{t=1}^T r^H_t(a_t)\right].
   180	\]
   181	Combining, we get, 
   182	\[
   183	\begin{aligned}
   184	    R(T)
   185	    &=
   186	    \max_{a \in [0,1]}
   187	    \mathbb{E}\left[\sum_{t=1}^T r_t(a)\right]
   188	    -
   189	    \mathbb{E}\left[\sum_{t=1}^T r_t(a_t)\right] \\
   190	    &\leq
   191	    \max_{a \in [0,1]}
   192	    \mathbb{E}\left[\sum_{t=1}^T r^H_t(a)\right]
   193	    -
   194	    \mathbb{E}\left[\sum_{t=1}^T r^H_t(a_t)\right]
   195	    +
   196	    T\beta(H) \\
   197	    &=
   198	    R^H(T) + T\beta(H).
   199	\end{aligned}
   200	\]
   201	\end{proof}
   202	
   203	\begin{lemma}[Discretization comparison]\label{lem:discretization-comparison}
   204	Let \(K \geq 2\), and let
   205	\[
   206	    \mathcal{G}_K
   207	    =
   208	    \left\{0, \frac{1}{K}, \dots, \frac{K-1}{K}\right\}.
   209	\]
   210	Consider a grid-restricted problem where \(a_t \in
   211	\mathcal{G}_K\) for every \(t\). Define regret of a learner as
   212	\[
   213	    R^H_K(T)
   214	    =
   215	    \max_{b \in \mathcal{G}_K}
   216	    \mathbb{E}\left[\sum_{t=1}^T r^H_t(b)\right]
   217	    -
   218	    \mathbb{E}\left[\sum_{t=1}^T r^H_t(a_t)\right].
   219	\]
   220	Let \(R^H(T)\) be the regret of the same learner in the original
   221	problem, where the comparator may choose any fixed action in \([0,1]\):
   222	\[
   223	    R^H(T)
   224	    =
   225	    \max_{a \in [0,1]}
   226	    \mathbb{E}\left[\sum_{t=1}^T r^H_t(a)\right]
   227	    -
   228	    \mathbb{E}\left[\sum_{t=1}^T r^H_t(a_t)\right].
   229	\]
   230	Then,
   231	\[
   232	    R^H(T) \leq R^H_K(T) + \frac{T}{K}.
   233	\]
   234	\end{lemma}
   235	
   236	\begin{proof}
   237	Let \(L_t = \min\{H,T-t\}\). For every quote \(a \in [0,1]\), choose a grid
   238	point \(b(a) \in \mathcal{G}_K\) such that
   239	\[
   240	    b(a) \leq a
   241	    \qquad\text{and}\qquad
   242	    a - b(a) \leq \frac{1}{K}.
   243	\]
   244	This is possible by rounding \(a\) down to the nearest point of
   245	\(\mathcal{G}_K\).
   246	
   247	Fix \(a\) and write \(b = b(a)\). Since \(b \leq a\), any future price that
   248	exceeds \(a\) also exceeds \(b\). Therefore, if quote \(a\) trades within
   249	\(L_t\) steps, then quote \(b\) also trades within \(L_t\) steps. Equivalently,
   250	\[
   251	    \ind{\tau_t(a) \leq L_t}
   252	    \leq
   253	    \ind{\tau_t(b) \leq L_t}
   254	\]
   255	on every realized path. Hence, pathwise,
   256	\[
   257	\begin{aligned}
   258	    r^H_t(a)
   259	    &=
   260	    a\cdot \ind{\tau_t(a) \leq L_t} \\
   261	    &=
   262	    b\cdot \ind{\tau_t(a) \leq L_t}
   263	    +
   264	    (a-b)\cdot \ind{\tau_t(a) \leq L_t} \\
   265	    &\leq
   266	    b\cdot \ind{\tau_t(b) \leq L_t}
   267	    +
   268	    (a-b) \\
   269	    &\leq
   270	    r^H_t(b) + \frac{1}{K}.
   271	\end{aligned}
   272	\]
   273	Taking expectations and summing over \(t\), we get
   274	\[
   275	    \mathbb{E}\left[\sum_{t=1}^T r^H_t(a)\right]
   276	    \leq
   277	    \mathbb{E}\left[\sum_{t=1}^T r^H_t(b(a))\right]
   278	    +
   279	    \frac{T}{K}
   280	    \leq
   281	    \max_{b \in \mathcal{G}_K}
   282	    \mathbb{E}\left[\sum_{t=1}^T r^H_t(b)\right]
   283	    +
   284	    \frac{T}{K}.
   285	\]
   286	Since this holds for every \(a \in [0,1]\), the best continuum comparator is
   287	within \(T/K\) of the best grid comparator:
   288	\[
   289	    \max_{a \in [0,1]}
   290	    \mathbb{E}\left[\sum_{t=1}^T r^H_t(a)\right]
   291	    \leq
   292	    \max_{b \in \mathcal{G}_K}
   293	    \mathbb{E}\left[\sum_{t=1}^T r^H_t(b)\right]
   294	    +
   295	    \frac{T}{K}.
   296	\]
   297	Subtracting the learner's expected truncated reward
   298	\(\mathbb{E}\left[\sum_{t=1}^T r^H_t(a_t)\right]\) from both sides yields
   299	\[
   300	    R^H(T) \leq R^H_K(T) + \frac{T}{K}.
   301	\]
   302	\end{proof}
   303	
   304	\paragraph{Putting the terms together.}
   305	The proof sketch above began by pretending that the problem already has \(K\)
   306	arms. Lemma~\ref{lem:discretization-comparison} explains how to justify this:
   307	run the learner on the grid \(\mathcal{G}_K\), and then compare its performance
   308	to the original comparator. If the delayed finite-arm algorithm
   309	guarantees
   310	\[
   311	    R^H_K(T) = O\left(\sqrt{T H \log K}\right),
   312	\]
   313	then Lemmas~\ref{lem:truncation-comparison}
   314	and~\ref{lem:discretization-comparison} give
   315	\[
   316	\begin{aligned}
   317	    R(T)
   318	    &\leq
   319	    R^H(T) + T\beta(H) \\
   320	    &\leq
   321	    R^H_K(T) + \frac{T}{K} + T\beta(H) \\
   322	    &=
   323	    O\left(\sqrt{T H \log K}\right)
   324	    +
   325	    \frac{T}{K}
   326	    +
   327	    T\beta(H).
   328	\end{aligned}
   329	\]
   330	Thus the regret bound has three terms:
   331	\[
   332	    \underbrace{O\left(\sqrt{T H \log K}\right)}_{\text{learning with delay}}
   333	    +
   334	    \underbrace{\frac{T}{K}}_{\text{discretization}}
   335	    +
   336	    \underbrace{T\beta(H)}_{\text{truncation}}.
   337	\]
   338	The discretization term is explicitly \(T/K\).
   339	
   340	The parameters \(K\) and \(H\) should be chosen to balance these three terms.
   341	For a fixed \(H\), the grid should be fine enough that \(T/K\) does not
   342	dominate the delayed-learning term. Since \(K\) appears only logarithmically in
   343	the delayed-learning term, a simple safe choice is \(K=T\), which makes
   344	\(T/K=1\) and gives
   345	\[
   346	    R(T)
   347	    \leq
   348	    O\left(\sqrt{T H \log T}\right)
   349	    +
   350	    T\beta(H)
   351	    +
   352	    1.
   353	\]
   354	A more economical choice, up to logarithmic factors, is to take
   355	\(K \approx \sqrt{T/H}\), which makes the discretization term no larger than
   356	the delayed-learning term.
   357	
   358	After \(K\) is chosen, \(H\) controls the tradeoff between the delayed-learning
   359	term and the truncation term. Increasing \(H\) makes the finite-arm delayed
   360	learning problem harder, because the term \(\sqrt{T H \log K}\) grows with
   361	\(H\). But increasing \(H\) also makes the truncation error \(T\beta(H)\)
   362	smaller. The best choice is therefore obtained by approximately solving
   363	\[
   364	    \sqrt{T H(T) \log K(T)}
   365	    \approx
   366	    T\beta(H(T)).
   367	\]
   368	Equivalently, with the simple choice \(K=T\), one balances
   369	\[
   370	    \beta(H(T))
   371	    \approx
   372	    \sqrt{\frac{H(T)\log T}{T}}.
   373	\]
   374	There is no universal optimal \(H(T)\) without more information about the decay
   375	of \(\beta\). If \(\beta(h) \lesssim h^{-\alpha}\), then the balancing choice
   376	with \(K=T\) is
   377	\[
   378	    H(T) \asymp \left(\frac{T}{\log T}\right)^{1/(2\alpha+1)},
   379	\]
   380	which gives regret of order
   381	\[
   382	    T^{(\alpha+1)/(2\alpha+1)}(\log T)^{\alpha/(2\alpha+1)}
   383	\]
   384	up to constants. If instead \(\beta(h)\) decays exponentially, then \(H(T)\)
   385	only needs to grow logarithmically in \(T\), giving regret nearly
   386	\(\sqrt{T}\) up to logarithmic factors.
   387	
   388	For the qualitative sublinear-regret result, Assumption~\ref{ass:tail-delays}
   389	is enough. Choose \(H(T)\to\infty\) slowly enough that
   390	\(H(T)\log T=o(T)\), and take \(K=T\). Then
   391	\(\sqrt{T H(T)\log T}=o(T)\), \(T\beta(H(T))=o(T)\), and \(T/K=1\).
   392	
   393	
   394	\medskip
   395	\noindent\emph{Only if direction.}
   396	\end{proof}
   397	
   398	\end{document}

