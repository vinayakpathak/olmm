from itertools import product

def values(M,N,ell,h,ps):
    P=[None]+[h]*M+[0]*N+[ell,h]
    n=len(P)-1
    out=[]
    for T in range(1,n+1):
        # suffix max for each t<T
        Ms=[]
        for t in range(1,T):
            Ms.append(max(P[t+1:T+1]) if t<T else 0)
        # comparator among ell"'^-, h''^- enough for two levels; include 0
        V=max(
            ell*sum(1 for m in Ms if m>=ell),
            h*sum(1 for m in Ms if m>=h),
            0,
        )
        pay=0
        for idx,t in enumerate(range(1,T)):
            m=Ms[idx]
            p=ps[t-1]
            if m>=h:
                pay += p*ell + (1-p)*h
            elif m>=ell:
                pay += p*ell
        out.append(V-pay)
    return out

def formula(M,N,ell,h):
    S=max(0, ell*(M+N)-h*max(M-1,0))
    return S*(1-ell/h)

def construction(M,N,ell,h):
    n=M+N+2
    S=max(0, ell*(M+N)-h*max(M-1,0))
    if M==0:
        active=list(range(1,N+1))
    else:
        active=list(range(M,M+N+1))
    g=len(active)
    p=0 if g==0 else S/(h*g)
    ps=[0.0]*(n-1)  # p=0 means h''^-
    for t in active:
        if 1 <= t <= n-1:
            ps[t-1]=p
    return ps

cases=[(0,0,.4,1),(0,3,.4,1),(1,0,.75,1),(1,2,.75,1),(2,0,.4,1),(2,0,.75,1),(4,1,.6,1),(4,10,.6,1),(3,2,.8,1)]
for M,N,ell,h in cases:
    ps=construction(M,N,ell,h)
    ds=values(M,N,ell,h,ps)
    F=formula(M,N,ell,h)
    print((M,N,ell,h),'"'formula',round(F,8),'max construction',round(max(ds),8),'deficits', [round(x,8) for x in ds])

# Coarse brute force for very small n to catch bad formula. Grid restricts to ell/h mixtures at every time.
print('coarse brute')
for M,N,ell,h in [(0,2,.4,1),(1,1,.75,1),(2,0,.75,1),(2,1,.4,1)]:
    n=M+N+2
    grid=[i/10 for i in range(11)]
    best=99
    bestps=None
    for ps in product(grid, repeat=n-1):
        m=max(values(M,N,ell,h,ps))
        if m<best:
            best=m; bestps=ps
    print((M,N,ell,h),'formula',formula(M,N,ell,h),'gridbest',best,'bestps',bestps)
