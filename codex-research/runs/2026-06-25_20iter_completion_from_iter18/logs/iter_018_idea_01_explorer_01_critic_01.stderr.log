    # compute V at low times
    S=[]
    for sj in s:
        T=sj
        Ms=[max(P[t+1:T]) if t+1<T else 0 for t in range(T-1)]
        candidates=sorted({0,h,*levels,*Ms})
        V=max(sum(b for Mv in Ms if b<=Mv and b>0) for b in candidates)
        S.append(V-h*H)
    idx={}; k=0
    for i in range(r):
        for c in levels:
            idx[(i,c)]=k; k+=1
    zidx=k; m=k+1; cons=[]
    for key,i in idx.items():
        a=np.zeros(m); a[i]=-1; cons.append((a,0,f'x{key}>=0'))
    for i,cap in enumerate(caps):
