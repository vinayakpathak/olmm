from itertools import combinations

def solve_linear(A,b):
    n=len(b)
    M=[list(map(float,A[i]))+[float(b[i])] for i in range(n)]
    for col in range(n):
        piv=max(range(col,n), key=lambda r: abs(M[r][col]))
        if abs(M[piv][col])<1e-10:
            return None
        M[col],M[piv]=M[piv],M[col]
        div=M[col][col]
        for j in range(col,n+1): M[col][j]/=div
        for r in range(n):
            if r==col: continue
            fac=M[r][col]
            if abs(fac)>1e-12:
                for j in range(col,n+1): M[r][j]-=fac*M[col][j]
    return [M[i][n] for i in range(n)]

def solve_lp(m, constraints, obj):
    best=1e99; bestv=None; bestnames=None
    for inds in combinations(range(len(constraints)), m):
        A=[constraints[i][0] for i in inds]
        b=[constraints[i][1] for i in inds]
        v=solve_linear(A,b)
        if v is None: continue
