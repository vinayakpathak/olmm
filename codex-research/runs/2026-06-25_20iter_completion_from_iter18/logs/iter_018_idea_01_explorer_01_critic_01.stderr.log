from itertools import combinations
import numpy as np

def solve_lp(num_x, constraints, obj_index):
    # constraints: list (a,b,name) meaning a dot v <= b
    m=num_x
    best=None; bestv=None; bestnames=None
    for inds in combinations(range(len(constraints)), m):
        A=np.array([constraints[i][0] for i in inds], float)
        b=np.array([constraints[i][1] for i in inds], float)
        try:
            v=np.linalg.solve(A,b)
        except np.linalg.LinAlgError:
            continue
        if all(np.dot(a,v) <= b+1e-8 for a,b,_ in constraints):
            val=v[obj_index]
            if best is None or val<best-1e-8:
                best=val; bestv=v; bestnames=[constraints[i][2] for i in inds]
    return best,bestv,bestnames

def full_lp(P,h):
    n=len(P)
    lows=sorted({p for p in P if 0<p<h})
    # variables x_{t,c} for t=0..n-2, c in lows, plus z
    idx={}
    k=0
    for t in range(n-1):
        for c in lows:
            idx[(t,c)]=k; k+=1
    zidx=k; m=k+1
    cons=[]
    # x >=0 -> -x <=0; capacity per t sum lows <=1; z>=0
    for key,i in idx.items():
        a=np.zeros(m); a[i]=-1; cons.append((a,0,f'x{key}>=0'))
    for t in range(n-1):
        a=np.zeros(m)
        for c in lows: a[idx[(t,c)]]=1
        cons.append((a,1,f'cap t{t+1}'))
    a=np.zeros(m); a[zidx]=-1; cons.append((a,0,'z>=0'))
    # horizons T=1..n, use 1-index in names, T index exclusive in Python
    for T in range(1,n+1):
        # thresholds M_t,T for t<T (t 0..T-2)
        Ms=[]
        for t in range(T-1):
            Ms.append(max(P[t+1:T]) if t+1<T else 0)
        # comparator V
        candidates=sorted({0,h,*lows,*Ms})
        V=0
        for b in candidates:
            val=sum(b for M in Ms if b<=M and b>0) # formal left-limit at support values; b=0 zero
            if val>V: V=val
        # payoff with default h and low mass deviations: default contribution h if h<=M; low c contribution c if c<=M instead of default
        base=0.0
        coeff=np.zeros(m)
        for t,M in enumerate(Ms):
            default = h if h<=M else 0.0
            base += default
            for c in lows:
                pay = c if c<=M else 0.0
                coeff[idx[(t,c)]] += (pay-default)
        # z >= V - (base + coeff*x) => -z - coeff*x <= base - V? Actually V-base-coeff*x - z <=0 -> -coeff*x - z <= base-V
        a=np.zeros(m); a[:zidx]= -coeff[:zidx]; a[zidx]=-1
        cons.append((a,base-V,f'def T{T} V={V} base={base}'))
    return solve_lp(m,cons,zidx), idx, lows

def reduced_lp(M,Ns,lows_seq,L,h):
    # lows_seq list ell_1..ell_r, Ns length r: N0..N_{r-1}; L post low ignored except final horizon
    r=len(lows_seq); levels=sorted(set(lows_seq))
