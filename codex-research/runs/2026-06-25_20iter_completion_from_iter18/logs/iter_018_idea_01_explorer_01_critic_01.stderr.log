    s=[]; pos=M
    for j,ell in enumerate(lows_seq):
        pos += Ns[j]+1
        s.append(pos)
    caps=[Ns[0]+(1 if M>=1 else 0)] + [Ns[i]+1 for i in range(1,r)]
