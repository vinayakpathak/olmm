diff --git a/.codex-research/runs/2026-06-25_20iter_delayed-market-making-tail-characterization/working_notes/claim_ledger.md b/.codex-research/runs/2026-06-25_20iter_delayed-market-making-tail-characterization/working_notes/claim_ledger.md
