   692	  \[
   693	  \sum_t\int\max_{a\in G}\sum_{\theta\in F}\pi_\theta f^\theta_{t,a}\,d\lambda_t
   694	  =
   695	  \sum_t\mathbb E_{\bar P_\pi}\max_{a\in G}
