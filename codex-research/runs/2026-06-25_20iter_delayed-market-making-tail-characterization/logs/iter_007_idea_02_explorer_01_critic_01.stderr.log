import random, math

def revenue(vals, probs):
    # exact sup over strict >: check intervals just below support values
    xs=sorted(set(vals))
    best=0.0
    for x in xs:
        # left limit at x: P(C>=x)
        tail=sum(p for v,p in zip(vals,probs) if v>=x-1e-15)
        best=max(best, x*tail)
    # also a between support points has lower tail and max at right endpoint left, covered by next support
    return best

for m in range(2,8):
    target=((m-1)/m)**m
    best=(-1,None)
    for _ in range(200000):
        vals=sorted([random.random() for _ in range(m)])
        # force top sometimes near 1
        if random.random()<0.4: vals[-1]=1.0
        ws=[random.expovariate(1) for _ in range(m)]
        s=sum(ws); probs=[w/s for w in ws]
        R=revenue(vals,probs)
        gap=sum(v*p for v,p in zip(vals,probs))-R
        if gap>best[0]: best=(gap,(vals,probs,R))
    print(m, 'target', target, 'best', best[0], 'ratio', best[0]/target)
    vals,probs,R=best[1]
    print(' vals', ['%.4f'%v for v in vals], 'tail rev', R)
    print(' probs', ['%.4f'%p for p in probs])
