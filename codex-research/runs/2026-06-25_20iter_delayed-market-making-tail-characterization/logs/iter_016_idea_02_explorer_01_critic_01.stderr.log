from itertools import product

def path(M,Ns,L,l,h):
    P=[]
    P += [h]*M
    for j,N in enumerate(Ns):
        P += [0]*N
        P += [l]
    P += [0]*L
    P += [h]
    return P

def formula(M,Ns,L,l,h):
    sr = M + sum(Ns) + (len(Ns)-1) + 1
    Ar = sr - 1
    H = max(M-1,0)
    return max(l*Ar - h*H,0)*(1-l/h)

def Vstar(P,T,l,h):
    # formal left-limit at l,h only: V = max(l count suffix>=l, h count suffix>=h)
    vl=vh=0
    for t in range(T-1):
        m=max(P[t+1:T]) if t+1<T else 0
        if m>=l: vl += l
        if m>=h: vh += h
    return max(vl,vh)

def reward(P,T,p,l,h):
    # p[t]=prob low quote, else high quote; formal low earns l if suffix>=l, high earns h if suffix>=h
    s=0
    for t in range(T-1):
        m=max(P[t+1:T]) if t+1<T else 0
        if m>=l: s += p[t]*l
        if m>=h: s += (1-p[t])*h
    return s

def brute(P,l,h,step=.1):
    n=len(P)
    vals=[i*step for i in range(int(1/step)+1)]
    best=999
    bestp=None
    for p in product(vals, repeat=n-1):
        z=max(Vstar(P,T,l,h)-reward(P,T,p,l,h) for T in range(1,n+1))
        if z<best-1e-9:
            best=z; bestp=p
    return best,bestp

cases=[(0,[1],0,.4,1),(1,[1],0,.4,1),(2,[1],0,.4,1),(3,[1],0,.4,1),(1,[1,0],0,.4,1),(2,[0,1],2,.4,1),(2,[1,1],1,.6,1),(3,[0,0,0],2,.45,1)]
for c in cases:
    M,Ns,L,l,h=c
    P=path(M,Ns,L,l,h)
    if len(P)-1<=8:
        b,p=brute(P,l,h,step=.05)
    else:
        b,p=(None,None)
    print(c,'n',len(P),'P',P,'formula',formula(M,Ns,L,l,h),'brute',b,'p',p)
PY" in /Users/vinayakpathak/olmm/.codex-research/runs/2026-06-25_20iter_delayed-market-making-tail-characterization
