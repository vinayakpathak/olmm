from fractions import Fraction
from itertools import combinations

def gauss(A,b):
    n=len(A)
    M=[list(map(Fraction,row))+[Fraction(bi)] for row,bi in zip(A,b)]
    r=0
    pivots=[]
    for c in range(n):
        piv=None
        for i in range(r,n):
            if M[i][c]"'!=0:
                piv=i;break
        if piv is None: continue
        M[r],M[piv]=M[piv],M[r]
        fac=M[r][c]
        M[r]=[x/fac for x in M[r]]
        for i in range(n):
            if i!=r and M[i][c]!=0:
                fac=M[i][c]
                M[i]=[M[i][j]-fac*M[r][j] for j in range(n+1)]
        pivots.append(c)
        r+=1
        if r==n: break
    if r<n: return None
    x=[Fraction(0) for _ in range(n)]
    for i,c in enumerate(pivots): x[c]=M[i][-1]
    return x

def lp_value(path, ell, h):
    n=len(path)
    d=n # p_1..p_{n-1}, z => n variables when n-1 p vars
    constraints=[] # A x <= b
    # horizon constraints T=1..n (1-index); T=1 no quotes
    for T in range(1,n+1):
        # compute V
        Lell=max([s for s in range(1,T+1) if path[s-1]>=ell] or [0])
        Lh=max([s for s in range(1,T+1) if path[s-1]>=h] or [0])
        V=max(ell*max(Lell-1,0), h*max(Lh-1,0))
        coeff=[Fraction(0) for _ in range(d)]
        const=V
        for t in range(1,T):
            future=path[t:T] # positions t+1..T in 1-index => list indices t..T-1
            Iell=any(p>=ell for p in future)
            Ih=any(p>=h for p in future)
            base=h if Ih else Fraction(0)
            low=ell if Iell else Fraction(0)
            const-=base
            coeff[t-1]-=(low-base) # V - (base+p*(low-base)) - z <= 0
        coeff[-1]-=1
        constraints.append((coeff, -const)) # coeff*x <= -const? wait const + sum c p - z <=0 => sum c p - z <= -const
    # p bounds, z bound
    for i in range(n-1):
        c=[Fraction(0) for _ in range(d)]; c[i]=1; constraints.append((c,Fraction(1)))
        c=[Fraction(0) for _ in range(d)]; c[i]=-1; constraints.append((c,Fraction(0)))
    c=[Fraction(0) for _ in range(d)]; c[-1]=-1; constraints.append((c,Fraction(0)))
    best=None; bestx=None; active=None
    m=len(constraints)
    for idxs in combinations(range(m), d):
        A=[constraints[i][0] for i in idxs]
        b=[constraints[i][1] for i in idxs]
        x=gauss(A,b)
        if x is None: continue
        ok=True
        for a,bb in constraints:
            if sum(ai*xi for ai,xi in zip(a,x)) > bb:
                ok=False; break
        if ok and (best is None or x[-1]<best):
            best=x[-1]; bestx=x; active=idxs
    return best,bestx,active

def make_path(M,Ns,L,ell,h):
    path=[h]*M
    for j,N in enumerate(Ns):
        path += [Fraction(0)]*N
        path += [ell]
    path += [Fraction(0)]*L
    path += [h]
    return path

def formula(M,Ns,L,ell,h):
    # r=len(Ns)-1, last low time s_r = M + sum Ns + (r+1)
    sr=M+sum(Ns)+len(Ns)
    Ar=sr-1
    H=max(M-1,0)
    S=max(ell*Ar-h*H, Fraction(0))
    return S*(h-ell)/h

cases=[
    (0,[0],0,Fraction(1,2),Fraction(1)),
    (0,[0,0],0,Fraction(1,2),Fraction(1)),
    (1,[0],0,Fraction(1,2),Fraction(1)),
    (2,[0],3,Fraction(1,2),Fraction(1)),
    (3,[2,0,1],2,Fraction(2,3),Fraction(1)),
    (4,[0,0,0],1,Fraction(3,5),Fraction(1)),
    (5,[1,2],0,Fraction(2,5),Fraction(1)),
    (2,[1,0,2],1,Fraction(3,7),Fraction(5,7)),
]
for case in cases:
    M,Ns,L,ell,h=case
    path=make_path(M,Ns,L,ell,h)
    if len(path)>10:
        print('"'skip large', case, 'n', len(path)); continue
    val,x,act=lp_value(path,ell,h)
    f=formula(M,Ns,L,ell,h)
    print('case',case,'n',len(path),'LP',val,'formula',f,'ok',val==f)
    # print p,z for insight
    print('  p=', x[:-1] if x else None, 'z=', x[-1] if x else None)
